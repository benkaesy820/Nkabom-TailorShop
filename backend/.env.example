# Node
TZ=UTC
PORT=3333
HOST=localhost
NODE_ENV=development

# App
LOG_LEVEL=info
APP_KEY=
APP_URL=http://localhost:3333

# Session
SESSION_DRIVER=cookie

# Turso (server-side only)
TURSO_DATABASE_URL=turso://YOUR_DATABASE.turso.io
TURSO_AUTH_TOKEN=
# Destructive database scripts refuse to run unless this exactly matches the URL host.
TURSO_DATABASE_HOST_GUARD=YOUR_DATABASE.turso.io
TURSO_CONNECTION_POOL_SIZE=4

# Local development mail (Mailpit UI: http://localhost:8025)
FRONTEND_URL=http://localhost:5173
SMTP_HOST=localhost
SMTP_PORT=1025
MAIL_FROM_ADDRESS=no-reply@nkabom.local
