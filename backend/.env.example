DIRECT_DATABASE_URL=postgresql://USER:PASSWORD@DIRECT_NEON_HOST/nkabom_dev?sslmode=require&channel_binding=require

# Local development mail (Mailpit UI: http://localhost:8025)
FRONTEND_URL=http://localhost:5173
SMTP_HOST=localhost
SMTP_PORT=1025
MAIL_FROM_ADDRESS=no-reply@nkabom.local

